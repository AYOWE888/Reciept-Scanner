# GEMINI_API_KEY: Required for Gemini AI OCR API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_CLIENT_ID: Required for Google OAuth 2.0 / OIDC Sign-In and Google Sheets API access.
GOOGLE_CLIENT_ID="745576921142-63e6nrfnb9ams9g35d3n0oa364tcprnk.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="745576921142-63e6nrfnb9ams9g35d3n0oa364tcprnk.apps.googleusercontent.com"

# GOOGLE_CLIENT_SECRET: Optional secret for server-side authorization code flow.
GOOGLE_CLIENT_SECRET=""

# GOOGLE_SHEET_ID: Target Google Spreadsheet ID for appending inventory rows.
GOOGLE_SHEET_ID=""

# DATABASE_PATH: Path to SQLite database file. Default: ./data/receipt_tracker.db
DATABASE_PATH="./data/receipt_tracker.db"

# APP_URL: The hosting URL of the application.
APP_URL="http://localhost:3000"

# PORT: Server listening port. Default: 3000
PORT=3000
